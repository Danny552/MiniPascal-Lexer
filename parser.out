Rule 10    section -> var_section
Rule 11    section -> procedure_declaration
Rule 12    section -> function_declaration
Rule 13    const_section -> CONST const_list
Rule 14    const_list -> const_list ID EQUALS expression SEMICOLON
Rule 15    const_list -> ID EQUALS expression SEMICOLON
Rule 16    type_section -> TYPE type_list
Rule 17    type_list -> type_list ID EQUALS type_specifier SEMICOLON
Rule 18    type_list -> ID EQUALS type_specifier SEMICOLON
Rule 19    var_section -> VAR var_list
Rule 20    var_list -> var_list id_list COLON type_specifier SEMICOLON
Rule 21    var_list -> id_list COLON type_specifier SEMICOLON
Rule 22    type_specifier -> type_base
Rule 23    type_specifier -> ARRAY LBRACKET range RBRACKET OF type_base
Rule 24    type_specifier -> STRING LBRACKET NUMBER RBRACKET
Rule 25    type_base -> INTEGER
Rule 26    type_base -> REAL
Rule 27    type_base -> CHAR
Rule 28    type_base -> BOOLEAN
Rule 29    range -> NUMBER DOT DOT NUMBER
Rule 30    procedure_declaration -> PROCEDURE ID LPAREN enter_args args RPAREN SEMICOLON compound_stmt SEMICOLON
Rule 31    function_declaration -> FUNCTION ID LPAREN enter_args args RPAREN COLON type_base SEMICOLON compound_stmt SEMICOLON
Rule 32    enter_args -> <empty>
Rule 33    compound_stmt -> BEGIN statement_list END
Rule 34    statement_list -> statement_list statement
Rule 35    statement_list -> statement
Rule 36    statement_list -> empty
Rule 37    statement -> call_stmt SEMICOLON
Rule 38    statement -> assignment_stmt SEMICOLON
Rule 39    statement -> compound_stmt
Rule 40    statement -> if_stmt
Rule 41    statement -> for_stmt
Rule 42    if_stmt -> IF LPAREN expression RPAREN THEN statement
Rule 43    if_stmt -> IF LPAREN expression RPAREN THEN statement ELSE statement
Rule 44    for_stmt -> FOR ID ASSIGN expression TO expression DO loop_guard statement
Rule 45    loop_guard -> <empty>
Rule 46    assignment_stmt -> ID ASSIGN expression
Rule 47    call_stmt -> ID LPAREN expression_list RPAREN
Rule 48    call_stmt -> ID
Rule 49    args -> arg_list
Rule 50    args -> empty
Rule 51    arg_list -> arg_spec
Rule 52    arg_list -> arg_list SEMICOLON arg_spec
Rule 53    arg_spec -> ID COLON type_base
Rule 54    arg_spec -> VAR ID COLON type_base
Rule 55    expression_list -> expression_list COMMA expression
Rule 56    expression_list -> expression
Rule 57    expression -> term
Rule 58    expression -> expression PLUS term
Rule 59    expression -> expression MINUS term
Rule 60    expression -> expression GREATER term
Rule 61    expression -> expression LESS term
Rule 62    expression -> expression GREATEREQUAL term
Rule 63    expression -> expression LESSEQUAL term
Rule 64    expression -> expression NOTEQUAL term
Rule 65    term -> factor
Rule 66    term -> term TIMES factor
Rule 67    term -> term DIVIDE factor
Rule 68    factor -> NUMBER
Rule 69    factor -> STRING
Rule 70    factor -> call_stmt
Rule 71    factor -> LPAREN expression RPAREN
Rule 72    empty -> <empty>

