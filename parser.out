Rule 46    loop_guard -> <empty>
Rule 47    assignment_stmt -> ID ASSIGN expression
Rule 48    call_stmt -> ID LPAREN expression_list RPAREN
Rule 49    call_stmt -> ID
Rule 50    args -> arg_list
Rule 51    args -> empty
Rule 52    arg_list -> arg_spec
Rule 53    arg_list -> arg_list SEMICOLON arg_spec
Rule 54    arg_spec -> ID COLON type_base
