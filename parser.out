Grammar

Rule 0     S' -> program
Rule 1     program -> PROGRAM ID SEMICOLON uses_clause declaration_sections compound_stmt DOT
Rule 2     uses_clause -> USES id_list SEMICOLON
Rule 3     uses_clause -> empty
Rule 4     id_list -> ID
Rule 5     id_list -> id_list COMMA ID
Rule 6     declaration_sections -> declaration_sections section
Rule 7     declaration_sections -> empty
Rule 8     section -> const_section
Rule 9     section -> type_section
Rule 10    section -> var_section
Rule 11    section -> procedure_declaration
Rule 12    section -> function_declaration
Rule 13    const_section -> CONST const_list
Rule 14    const_list -> const_list ID EQUALS expression SEMICOLON
Rule 15    const_list -> ID EQUALS expression SEMICOLON
Rule 16    type_section -> TYPE type_list
Rule 17    type_list -> type_list ID EQUALS type_specifier SEMICOLON
Rule 18    type_list -> ID EQUALS type_specifier SEMICOLON
Rule 19    var_section -> VAR var_list
Rule 20    var_list -> var_list id_list COLON type_specifier SEMICOLON
Rule 21    var_list -> id_list COLON type_specifier SEMICOLON
Rule 22    type_specifier -> ID
Rule 23    type_specifier -> type_base
Rule 24    type_specifier -> ARRAY LBRACKET range RBRACKET OF type_base
Rule 25    type_specifier -> STRING LBRACKET NUMBER RBRACKET
Rule 26    type_base -> INTEGER
Rule 27    type_base -> REAL
Rule 28    type_base -> CHAR
Rule 29    type_base -> BOOLEAN
Rule 30    range -> NUMBER DOT DOT NUMBER
Rule 31    procedure_declaration -> PROCEDURE ID LPAREN args RPAREN SEMICOLON compound_stmt SEMICOLON
Rule 32    function_declaration -> FUNCTION ID LPAREN args RPAREN COLON type_specifier SEMICOLON compound_stmt SEMICOLON
Rule 33    compound_stmt -> BEGIN statement_list END
Rule 34    statement_list -> statement_list statement
Rule 35    statement_list -> statement
Rule 36    statement_list -> empty
Rule 37    statement -> call_stmt SEMICOLON
Rule 38    statement -> assignment_stmt SEMICOLON
Rule 39    statement -> compound_stmt
Rule 40    statement -> if_stmt
Rule 41    statement -> for_stmt
Rule 42    if_stmt -> IF LPAREN expression RPAREN THEN statement
Rule 43    if_stmt -> IF LPAREN expression RPAREN THEN statement ELSE statement
Rule 44    for_stmt -> FOR ID ASSIGN expression TO expression DO statement
Rule 45    assignment_stmt -> ID ASSIGN expression
Rule 46    call_stmt -> ID LPAREN expression_list RPAREN
Rule 47    call_stmt -> ID
Rule 48    args -> arg_list
Rule 49    args -> empty
Rule 50    arg_list -> ID COLON type_specifier
Rule 51    arg_list -> arg_list SEMICOLON ID COLON type_specifier
Rule 52    expression_list -> expression_list COMMA expression
Rule 53    expression_list -> expression
Rule 54    expression -> term
Rule 55    expression -> expression PLUS term
Rule 56    expression -> expression MINUS term
Rule 57    expression -> expression GREATER term
Rule 58    expression -> expression LESS term
Rule 59    expression -> expression GREATEREQUAL term
Rule 60    expression -> expression LESSEQUAL term
Rule 61    expression -> expression NOTEQUAL term
Rule 62    term -> factor
Rule 63    term -> term TIMES factor
Rule 64    term -> term DIVIDE factor
Rule 65    factor -> NUMBER
Rule 66    factor -> STRING
Rule 67    factor -> call_stmt
Rule 68    factor -> LPAREN expression RPAREN
Rule 69    empty -> <empty>

